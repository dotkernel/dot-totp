{
    "name": "dotkernel/dot-totp",
    "type": "library",
    "description": "DotKernel TOTP authorization component",
    "license": "MIT",
    "homepage": "https://github.com/dotkernel/dot-totp",
    "keywords": [
        "dotkernel",
        "mezzio",
        "totp"
    ],
    "authors": [
        {
            "name": "Dotkernel Team",
            "email": "team@dotkernel.com"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },

    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "endroid/qr-code":  "^6.0.9",
        "psr/container": "^1.1 || ^2.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.2",
        "phpstan/phpstan": "^2.1.33",
        "phpstan/phpstan-phpunit": "^2.0.10",
        "laminas/laminas-coding-standard": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Dot\\Totp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DotTest\\Totp\\": "test/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test",
            "@static-analysis"
        ],
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "static-analysis": "phpstan analyse --memory-limit 1G",
        "test": "phpunit --colors=always"
    }
}
